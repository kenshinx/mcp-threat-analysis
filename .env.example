# Database
MTA_DATABASE_URL=postgresql+asyncpg://mta:mta@localhost:5432/mta

# LLM (semantic_analysis)
# Provider: "anthropic" or "openai_compatible".
# openai_compatible covers OpenAI itself plus any compatible endpoint
# (Volcengine Ark, DeepSeek, Together, vLLM, …).
MTA_LLM_PROVIDER=anthropic

# When MTA_LLM_PROVIDER=openai_compatible, set both base_url and api_key.
# Example for Volcengine Ark:
#   MTA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
MTA_LLM_BASE_URL=
MTA_LLM_API_KEY=

# Model ids the provider knows. For Anthropic, defaults are claude-*.
# For openai_compatible, set whatever model id your endpoint exposes.
MTA_LLM_MODEL_BATCH=claude-haiku-4-5-20251001
MTA_LLM_MODEL_REALTIME=claude-sonnet-4-6

# Anthropic-only fallback: used when provider=anthropic and MTA_LLM_API_KEY
# is unset. Kept for back-compat.
ANTHROPIC_API_KEY=

MTA_LLM_DAILY_BUDGET_USD=200

# Embeddings (set to 'openai' to use OpenAI embeddings instead of hash stub)
MTA_EMBEDDING_PROVIDER=hash
MTA_EMBEDDING_DIM=1536

# External tool binaries (override only when not on PATH)
MTA_SEMGREP_BIN=semgrep
MTA_CODEQL_BIN=codeql
MTA_TRUFFLEHOG_BIN=trufflehog
MTA_GITLEAKS_BIN=gitleaks
MTA_OSV_BIN=osv-scanner
MTA_PIP_AUDIT_BIN=pip-audit
MTA_NPM_BIN=npm

# Resource limits
MTA_SEMGREP_TIMEOUT=300
MTA_CODEQL_TIMEOUT=600
MTA_ARTIFACT_MAX_BYTES=209715200
MTA_WORKDIR_ROOT=/tmp/mta-workdir

# L6 weights override
MTA_L6_WEIGHTS_YAML=
